# Copy to .env (which git ignores) and fill in the values you use. Every setting is optional:
# without provider keys, issues are recognized by the local model and keywords, and replies are
# built by rules. Load into the shell with:  set -a && source .env && set +a

# Fictional development principals; tokens must be at least 24 characters.
RESOLVELANE_API_TOKENS='{"local-dev-token-customer-101-xyz": {"subject_id": "demo-customer-101", "role": "customer"}}'

# Language model (any Anthropic-compatible endpoint)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# RESOLVELANE_LLM_TIMEOUT_S=10

# Remote embedding tier (any OpenAI-compatible /embeddings endpoint; use a different provider
# from the language model, so it keeps working when that provider is down)
RESOLVELANE_EMBEDDING_API_KEY=
# RESOLVELANE_EMBEDDING_BASE_URL=https://api.voyageai.com/v1
# RESOLVELANE_EMBEDDING_MODEL=voyage-4-lite

# Local embedding tier ("off" disables it)
# RESOLVELANE_LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# RESOLVELANE_MODEL_CACHE_DIR=~/.cache/resolvelane/models

# Case storage (SQLite file; ":memory:" keeps nothing after the process stops)
# RESOLVELANE_DATABASE=data/resolvelane.sqlite3

# Handling guides for the reply agent (default: the skills directory of this repository)
# RESOLVELANE_SKILLS_DIR=skills
