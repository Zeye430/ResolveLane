# Copy to .env (which git ignores) and fill in the values you use. Every setting is optional:
# without provider keys, issues are recognized by the local model and keywords, and replies are
# built by rules. Load into the shell with:  set -a && source .env && set +a

# Fictional development principals; tokens must be at least 24 characters.
# Roles: customer, support_agent, operator (reads /metrics only).
# The frontend's development server, and the web container unless RESOLVELANE_DEMO_SIGN_IN=false,
# offer these accounts in the sign-in menu.
RESOLVELANE_API_TOKENS='{"local-dev-token-customer-101-xyz": {"subject_id": "demo-customer-101", "role": "customer"}, "local-dev-token-customer-102-xyz": {"subject_id": "demo-customer-102", "role": "customer"}, "local-dev-token-customer-103-xyz": {"subject_id": "demo-customer-103", "role": "customer"}, "local-dev-token-customer-104-xyz": {"subject_id": "demo-customer-104", "role": "customer"}, "local-dev-token-agent-301-xyzxyz": {"subject_id": "demo-agent-301", "role": "support_agent"}, "local-dev-token-operator-501-xyz": {"subject_id": "demo-operator-501", "role": "operator"}}'

# The operator token Prometheus scrapes /metrics with (docker compose --profile monitoring)
RESOLVELANE_METRICS_TOKEN=local-dev-token-operator-501-xyz

# Language model (any Anthropic-compatible endpoint)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# RESOLVELANE_LLM_TIMEOUT_S=10
# Prices for cost estimates, in US dollars per million tokens, copied from your provider's price
# list. cache_read and cache_write default to the input price, which overstates the cost when the
# provider charges less for cached input. Without a price, usage is counted in tokens only.
# RESOLVELANE_MODEL_PRICES={"model-name": {"input": 0.0, "output": 0.0, "cache_read": 0.0}}

# Evaluation judge (python -m resolvelane.evaluation). By default the reply model's provider and model.
# A judge from another model family does not favour the agent's writing as its own: give it its own
# key, the provider's Anthropic-compatible endpoint and its model name, e.g. Kimi:
# RESOLVELANE_JUDGE_API_KEY=
# RESOLVELANE_JUDGE_BASE_URL=https://api.moonshot.ai/anthropic
# RESOLVELANE_JUDGE_MODEL=kimi-k3.1-pro
# Claude model names are refused at other endpoints: compatible providers answer them with their own models.

# Remote embedding tier (any OpenAI-compatible /embeddings endpoint; use a different provider
# from the language model, so it keeps working when that provider is down)
RESOLVELANE_EMBEDDING_API_KEY=
# RESOLVELANE_EMBEDDING_BASE_URL=https://api.voyageai.com/v1
# RESOLVELANE_EMBEDDING_MODEL=voyage-4-lite

# Local embedding tier ("off" disables it)
# RESOLVELANE_LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# RESOLVELANE_MODEL_CACHE_DIR=~/.cache/resolvelane/models

# Case storage (SQLite file; ":memory:" keeps nothing after the process stops)
# RESOLVELANE_DATABASE=data/resolvelane.sqlite3

# Handling guides for the reply agent (default: the skills directory of this repository)
# RESOLVELANE_SKILLS_DIR=skills

# External services over MCP (needs the mcp extra); see mcp_servers.example.json
# RESOLVELANE_MCP_CONFIG=mcp_servers.example.json

# Refund payments go to a simulated provider. "paused" keeps approved refunds in the outbox unsent.
# RESOLVELANE_PAYMENTS=paused
# Scripted provider faults for a demo, used in order: timeout_before, timeout_after, unavailable, decline
# RESOLVELANE_PAYMENT_FAULTS=timeout_after,decline
